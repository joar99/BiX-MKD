// ===================================================================
// eICU Collaborative Research Database v2.0 — schema
// Generated from the actual .csv.gz headers (types inferred from data).
// Paste into https://dbdiagram.io to render.
//
// HUB: `patient` — one row per ICU stay (patientunitstayid).
//   uniquepid ................ same human across stays
//   patienthealthsystemstayid  same hospital admission (may span stays)
//   hospitalid ............... the institution (208 of them)
//   hospitaldischargestatus .. Alive / Expired  <- MORTALITY LABEL
// ===================================================================

Table admissionDrug {
  admissiondrugid int [pk]
  patientunitstayid int [ref: > patient.patientunitstayid]
  drugoffset int
  drugenteredoffset int
  drugnotetype varchar
  specialtytype varchar
  usertype varchar
  rxincluded boolean
  writtenineicu boolean
  drugname varchar
  drugdosage float
  drugunit varchar
  drugadmitfrequency varchar
  drughiclseqno int
}

Table admissionDx {
  admissiondxid int [pk]
  patientunitstayid int [ref: > patient.patientunitstayid]
